# =========================================================================
# UNIVERSAL AGENT HARNESS - API KEYS TEMPLATE
# Duplicate this file to '.env' and fill in your private production keys.
# NEVER commit the actual '.env' file to Git.
# =========================================================================

# LLM Providers Configuration
CLAUDE_API_KEY=your_claude_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# MCP Servers Credentials (if applicable)
# Use a READ-ONLY database user.
MCP_POSTGRES_URL=postgresql://readonly_user:change_me@localhost:5432/db
MCP_GITHUB_TOKEN=your_github_personal_access_token_here

# Project Environment State
NODE_ENV=development
